{
  "name": "pdfnix",
  "productName": "PDFnix",
  "version": "0.4.0",
  "description": "PDFnix — a Windows desktop PDF reader and editor",
  "author": "PDFnix",
  "license": "AGPL-3.0-only",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "pnpm typecheck && electron-vite build",
    "notices": "uv run --directory engine python ../scripts/collect_licenses.py",
    "icons": "uv run --directory engine python ../scripts/make_icons.py",
    "dist": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:engine && pnpm build:engine && pnpm smoke:engine && pnpm notices && electron-vite build && electron-builder --win",
    "dist:dir": "pnpm build:engine && pnpm notices && electron-vite build && electron-builder --win --dir",
    "format": "prettier --write . && uv run --directory engine ruff format . ../scripts ../tests",
    "lint": "pnpm lint:app && pnpm lint:engine",
    "lint:app": "eslint --cache .",
    "lint:engine": "uv run --directory engine ruff check . ../scripts ../tests && uv run --directory engine ruff format --check . ../scripts ../tests",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "test": "vitest run",
    "test:engine": "uv run --directory engine pytest",
    "build:engine": "uv run --directory engine --group build pyinstaller pdfengine.spec --noconfirm --clean --log-level WARN --distpath ../dist-engine --workpath ../build-engine",
    "smoke:engine": "uv run --directory engine python smoke_frozen.py",
    "test:e2e": "playwright test --project=dev",
    "test:e2e:packaged": "playwright test --project=packaged",
    "test:perf": "playwright test --project=perf",
    "postinstall": "install-electron && electron-builder install-app-deps"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "electron-store": "^12.0.0",
    "lucide-react": "^1.72.0",
    "pdf-to-printer": "5.8.1",
    "radix-ui": "^1.8.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.1.0"
  }
}
